# See config.ts for list of server config variables
# See src/config.ts for list of client config variables

VITE_SERVER_HOST=
VITE_OAUTH_REDIRECT_HOSTNAME=

# Optional ICE/TURN configuration. Keep credentials out of source control.
VITE_TURN_SERVERS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Local access gate. The installer creates a strong admin password when this is blank.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_DATA_DIR=/usr/src/data
MEDIA_DATA_DIR=/usr/src/data/media
UPLOAD_MAX_BYTES=21474836480
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional server configuration (see server/config.ts).
YOUTUBE_API_KEY=
DATABASE_URL=
REDIS_URL=
PORT=8080
HOST=0.0.0.0
